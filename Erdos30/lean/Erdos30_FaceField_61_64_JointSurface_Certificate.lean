def n64JointSurfaceIndicesByRank : List Nat :=
  n64IndexList.filter (fun i => n64JointRank i == 0)

theorem n64_face_index_count :
    n64FaceIndices.card = 2360 := by
  native_decide

theorem n64_joint_surface_table_matches_packet :
    n64JointSurfaceIndicesByRank = [375, 878, 1165, 1273, 1320, 1800, 1861, 1919, 2030, 2166, 2315] := by
  native_decide

theorem n64_joint_surface_card :
    n64JointSurface.card = 11 := by
  native_decide

theorem n64_joint_surface_is_proper_exported_subface :
    n64JointSurface.card < n64FaceIndices.card := by
  native_decide

theorem n64_joint_surface_subset_face :
    n64JointSurface ⊆ n64FaceIndices := by
  native_decide

theorem n64_joint_surface_rank_zero {x : Nat} (hx : x ∈ n64JointSurface) :
    n64JointRank x = 0 := by
  native_decide +revert

theorem n64_joint_rank_positive_off_surface
    {y : Nat} (hy : y ∈ n64FaceIndices) (hnot : y ∉ n64JointSurface) :
    0 < n64JointRank y := by
  native_decide +revert

theorem n64_joint_surface_minimizer_certificate :
    Erdos.Collider.IsFieldMinimizerSet
      n64FaceIndices n64JointSurface n64JointRank := by
  apply Erdos.Collider.isFieldMinimizerSet_of_le_on_and_lt_off
  · exact n64_joint_surface_subset_face
  · intro x hx y _hy
    rw [n64_joint_surface_rank_zero hx]
