def n63JointSurfaceIndicesByRank : List Nat :=
  n63IndexList.filter (fun i => n63JointRank i == 0)

theorem n63_face_index_count :
    n63FaceIndices.card = 1022 := by
  native_decide

theorem n63_joint_surface_table_matches_packet :
    n63JointSurfaceIndicesByRank = [138, 139, 371, 415, 477, 528, 564, 696, 889, 901] := by
  native_decide

theorem n63_joint_surface_card :
    n63JointSurface.card = 10 := by
  native_decide

theorem n63_joint_surface_is_proper_exported_subface :
    n63JointSurface.card < n63FaceIndices.card := by
  native_decide

theorem n63_joint_surface_subset_face :
    n63JointSurface ⊆ n63FaceIndices := by
  native_decide

theorem n63_joint_surface_rank_zero {x : Nat} (hx : x ∈ n63JointSurface) :
    n63JointRank x = 0 := by
  native_decide +revert

theorem n63_joint_rank_positive_off_surface
    {y : Nat} (hy : y ∈ n63FaceIndices) (hnot : y ∉ n63JointSurface) :
    0 < n63JointRank y := by
  native_decide +revert

theorem n63_joint_surface_minimizer_certificate :
    Erdos.Collider.IsFieldMinimizerSet
      n63FaceIndices n63JointSurface n63JointRank := by
  apply Erdos.Collider.isFieldMinimizerSet_of_le_on_and_lt_off
  · exact n63_joint_surface_subset_face
  · intro x hx y _hy
    rw [n63_joint_surface_rank_zero hx]
    exact Nat.zero_le (n63JointRank y)
  · intro y hy hnot
    refine ⟨138, ?_, ?_⟩
    · native_decide
    · have hanchor : n63JointRank 138 = 0 := by native_decide
      rw [hanchor]
      exact n63_joint_rank_positive_off_surface hy hnot

theorem n63_joint_selected_surface_certificate :
    Erdos.Collider.IsFieldMinimizerSet
      n63FaceIndices
      ([138, 139, 371, 415, 477, 528, 564, 696, 889, 901] : List Nat).toFinset
      n63JointRank := by
  simpa [n63JointSurface] using n63_joint_surface_minimizer_certificate

